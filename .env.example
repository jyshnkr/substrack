# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ─── Database ─────────────────────────────────────────────
# Connection pooler URL (used by the app at runtime)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres
# Direct connection URL (used by drizzle-kit for migrations)
DATABASE_URL_DIRECT=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── API Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Frontend (VITE_ prefix required for client-side access) ─
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
